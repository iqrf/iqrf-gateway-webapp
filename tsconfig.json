{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2020",
		"strict": true,
		"module": "ES2020",
		"moduleResolution": "Bundler",
		"noImplicitAny": false,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"baseUrl": ".",
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"types": [
			"node",
			"vuex/types/vue.d.ts"
		],
		"lib": ["ES2020", "DOM"],
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"src/**/*.vue",
		"cypress.config.ts",
		"eslint.config.ts",
		"vitest.config.ts"
	],

	"exclude": [
		"cypress",
		"node_modules",
		"temp"
	]
}
