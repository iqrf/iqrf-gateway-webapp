			"$id": "#/properties/id",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/apiKey.json#/definitions/id",
			"title": "API key ID"
		},
		"description": {
			"$id": "#/properties/description",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/apiKey.json#/definitions/description",
			"title": "API key description"
		},
		"expiration": {
			"$id": "#/properties/expiration",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/apiKey.json#/definitions/expiration",
