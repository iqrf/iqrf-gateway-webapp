{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$id": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/jwt.json",
	"type": "object",
	"title": "JWT + user and role info",
	"additionalProperties": false,
	"required": [
		"user",
		"role",
		"token"
	],
	"properties": {
		"user": {
			"$id": "#/properties/user",
			"title": "User detail",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/userDetail.json"
		},
		"role": {
			"$id": "#/properties/role",
			"title": "Role detail",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/roleDetail.json"
		},
		"token": {
			"$id": "#/properties/token",
			"type": "string",
			"pattern": "^[A-Za-z0-9-_=]+\\.[A-Za-z0-9-_=]+\\.?[A-Za-z0-9-_.+/=]*$",
			"title": "JSON Web Token",
			"example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lIn0.eyJpc3MiOiJBU1VTLUI4NS1QUk8tR0FNRVIiLCJqdGkiOiJBU1VTLUI4NS1QUk8tR0FNRVIiLCJpYXQiOiIxNTg3MjE2NjMzLjQ2NDEzNyIsImV4cCI6IjE1ODczMDMwMzMuNDY0MTM3IiwidWlkIjoxfQ."
		}
	}
}
