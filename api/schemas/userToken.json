{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$id": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/jwt.json",
	"type": "object",
	"title": "JWT + user info",
	"additionalProperties": false,
	"required": [
		"id",
		"username",
		"email",
		"language",
		"roleId",
		"state",
		"token"
	],
	"properties": {
		"id": {
			"$id": "#/properties/id",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/user.json#/definitions/id"
		},
		"username": {
			"$id": "#/properties/username",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/user.json#/definitions/username"
		},
		"email": {
			"$id": "#/properties/email",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/user.json#/definitions/email"
		},
		"language": {
			"$id": "#/properties/language",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/user.json#/definitions/language"
		},
		"roleId": {
			"$id": "#/properties/roleId",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/user.json#/definitions/roleId"
		},
		"state": {
			"$id": "#/properties/state",
			"$ref": "https://apidocs.iqrf.org/openapi/iqrf-gateway-webapp/schemas/definitions/user.json#/definitions/state"
		},
		"token": {
			"$id": "#/properties/token",
			"type": "string",
			"pattern": "^[A-Za-z0-9-_=]+\\.[A-Za-z0-9-_=]+\\.?[A-Za-z0-9-_.+/=]*$",
			"title": "JSON Web Token",
			"example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJub25lIn0.eyJpc3MiOiJBU1VTLUI4NS1QUk8tR0FNRVIiLCJqdGkiOiJBU1VTLUI4NS1QUk8tR0FNRVIiLCJpYXQiOiIxNTg3MjE2NjMzLjQ2NDEzNyIsImV4cCI6IjE1ODczMDMwMzMuNDY0MTM3IiwidWlkIjoxfQ."
		}
	}
}
